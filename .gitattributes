# Normalize text files in Git
* text=auto

# Keep shell scripts with LF endings
*.sh text eol=lf
gradlew text eol=lf

# Keep Windows batch files with CRLF endings
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Common project files
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
